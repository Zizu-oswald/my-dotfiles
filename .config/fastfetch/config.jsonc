{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small", // search for logos: fastfetch --list-logos or --print-logos
        "padding": {
	        "top": 1,
            "left": 3
	},
    },
    "display": {
        "separator": " "
    },
    "modules": [
    // "break",
	"title",
        {
            "type": "os",
            "key": " OS____",
            "keyColor": "magenta"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "keyColor": "magenta"
        },
        {
            "type": "wm",
            "key": " WM____",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " Shell_",
            "keyColor": "magenta"
        },
        // {
        //     "type": "packages",
        //     "format": "{} (pacman)",
        //     "key": " pkgs:",
        //     "keyColor": "magenta"
        // },
        {
            "type": "disk",
            "key": "󰋊 Disk__",
            "keyColor": "magenta",
        },
        // {
        //     "type": "monitor",
        //     "key": " Monitor",
        //     "keyColor": "magenta",
        // },
        {
            "type": "uptime",
            "key": " Uptime",
            "keyColor": "magenta"
        },
        {
            "type": "command",
            "key": " OS Age",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
            "keyColor": "magenta"
        },
    "break",
    ]
}
