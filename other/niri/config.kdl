// ============================================================
//  Конфиг niri (прокручиваемый тайловый Wayland-композитор)
//  Комментарии добавлены, сами настройки не менялись.
//  Mod = клавиша Super (Win), когда niri запущен на железе,
//  и Alt, когда запущен во вложенном окне.
// ============================================================

// ------------------------------------------------------------
//  Устройства ввода
// ------------------------------------------------------------
input {
    keyboard {
        xkb {
            // Две раскладки: английская (us) и русская (ru)
            layout "us,ru"
            // Переключение раскладки по Alt+CapsLock
            options "grp:alt_caps_toggle"
        }
        // Раскладка запоминается отдельно для каждого окна
        track-layout "window"
        // Включать NumLock при старте
        numlock
    }
    touchpad {
        // Клик касанием (tap-to-click)
        tap
        // Естественная прокрутка (как на смартфоне)
        natural-scroll
    }
    // Мышь, трекпойнт: настройки по умолчанию
    mouse {
    }
    trackpoint {
    }
}

// ------------------------------------------------------------
//  Мониторы
// ------------------------------------------------------------
// Блок закомментирован через "/-" (slashdash), поэтому не действует.
// Если раскомментировать (убрать "/-"), встроенный экран eDP-1 получит:
// разрешение 1920x1080 при 120 Гц, масштаб 1.5, без поворота и
// положение x=1280, y=0 в общем пространстве мониторов.
// Сейчас настройки выходов подключаются ниже через include "dms/outputs.kdl".
/-output "eDP-1" {
    mode "1920x1080@120.030"
    scale 1.5
    transform "normal"
    position x=1280 y=0
}

// ------------------------------------------------------------
//  Раскладка окон (layout)
// ------------------------------------------------------------
layout {
    // Отступ между окнами (в логических пикселях)
    gaps 6
    // Не центрировать колонку с фокусом автоматически
    center-focused-column "never"
    // Пресеты ширины колонки, переключаются по Mod+R: 1/3, 1/2, 2/3 экрана
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // Ширина новой колонки по умолчанию: половина экрана
    default-column-width { proportion 0.5; }
    // Кольцо фокуса: рамка вокруг активного окна (рисуется снаружи окна)
    focus-ring {
        width 1
        // Цвет рамки неактивных окон
        inactive-color "#505050"
        active-color "#6c7c2d"
    	// Градиент активной рамки: от зелёного к бирюзовому, угол 180°
    	// active-gradient from="#7bb377" to="#6fb0a4" angle=180 in="oklch"
    }
    // Обычная рамка окна: отключена (off), параметры ниже не действуют,
    // пока рамка не будет включена
    border {
        off
        width 3
        active-color "#ffc87f"
        inactive-color "#505050"
        // Цвет рамки окна, запросившего внимание
        urgent-color "#9b0000"
    }
    // Тень под окнами
    shadow {
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
    // Резервируемые поля по краям экрана (сейчас не заданы)
    struts {
    }
}

// ------------------------------------------------------------
//  Автозапуск и общие настройки
// ------------------------------------------------------------
// При старте запускает слежение за буфером обмена:
// каждое новое значение сохраняется в историю cliphist
spawn-sh-at-startup "wl-paste --watch cliphist store &"

hotkey-overlay {
    // Не показывать окно с подсказкой по горячим клавишам при запуске
    skip-at-startup
}

// Куда сохранять скриншоты и как называть файлы (дата и время в имени)
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Анимации: используются значения по умолчанию
animations {
    slowdown 0.7
}

// ------------------------------------------------------------
//  Правила для окон
// ------------------------------------------------------------
// WezTerm: пустая ширина по умолчанию означает, что окно само выбирает
// начальный размер, а не берёт общие 50% экрана
window-rule {
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width {}
}
// Окно "картинка в картинке" в Firefox открывается плавающим
window-rule {
    match app-id=r#"firefox$"# title="^Picture-in-Picture$"
    open-floating true
}
// Отключённое правило (slashdash): скрывало бы окна менеджеров паролей
// KeePassXC и Secrets при записи экрана и трансляции
/-window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}
// Правило для всех окон: скруглённые углы радиусом 10
// и обрезка содержимого по скруглённой границе
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

// ------------------------------------------------------------
//  Горячие клавиши
//  allow-when-locked=true: работает и на заблокированном экране
//  repeat=false: не повторять при удержании клавиши
// ------------------------------------------------------------
binds {
    // --- Справка ---
    // Показать окно с подсказкой по горячим клавишам
    Mod+Shift+Slash { show-hotkey-overlay; }

    // --- Запуск программ ---
    // Терминал (в подписи оверлея указан alacritty, но запускается kitty)
    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "kitty"; }
    // Лаунчер приложений fuzzel
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    // Спящий режим
    Super+Alt+L hotkey-overlay-title="Sleep mode" { spawn "systemctl" "suspend"; }
    // Блокировка экрана через DankMaterialShell (dms)
    Super+Alt+K hotkey-overlay-title="Lock the Screen: DMS" { spawn "dms" "ipc" "call" "lock" "lock"; }
    // Файловый менеджер yazi в терминале kitty
    Super+Y hotkey-overlay-title="Open yazi" {spawn "kitty" "zsh" "-c" "yazi"; }
    // История буфера обмена: выбор записи в fuzzel и возврат в буфер
    Super+P {spawn "sh" "-c" "cliphist list | fuzzel --dmenu --prompt='📋 ' --lines=10 --width=60 --match-mode=fzf | cliphist decode | wl-copy";}
    // Включить/выключить экранный диктор Orca (hotkey-overlay-title=null скрывает пункт из подсказки)
    Super+Alt+S allow-when-locked=true hotkey-overlay-title=null { spawn-sh "pkill orca || exec orca"; }

    // --- Мультимедийные клавиши ---
    // Громкость: +10% (не выше 100%), -10%, отключение звука
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    // Отключение микрофона
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    // Управление плеером: пауза, стоп, предыдущий и следующий трек
    XF86AudioPlay        allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop        allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev        allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext        allow-when-locked=true { spawn-sh "playerctl next"; }
    // Яркость экрана: шаг 10%
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // --- Обзор и закрытие окна ---
    // Режим обзора (все окна и рабочие столы)
    Mod+O repeat=false { toggle-overview; }
    // Закрыть окно
    Mod+W repeat=false { close-window; }

    // --- Перемещение фокуса ---
    // Стрелки и vim-клавиши (H/J/K/L): колонки влево/вправо, окна внутри колонки вверх/вниз
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }

    // --- Перемещение окон и колонок ---
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }

    // Фокус вниз/вверх: сначала по окнам в колонке, затем по рабочим столам
    Mod+J     { focus-window-or-workspace-down; }
    Mod+K     { focus-window-or-workspace-up; }
    // Перенос окна вниз/вверх: по колонке, а на краю на соседний рабочий стол
    Mod+Ctrl+J     { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+K     { move-window-up-or-to-workspace-up; }

    // Фокус на первую/последнюю колонку
    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }
    // Переместить колонку в начало/конец
    Mod+Ctrl+Home { move-column-to-first; }
    Mod+Ctrl+End  { move-column-to-last; }

    // --- Мониторы ---
    // Фокус на соседний монитор
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }
    Mod+Shift+H     { focus-monitor-left; }
    Mod+Shift+J     { focus-monitor-down; }
    Mod+Shift+K     { focus-monitor-up; }
    Mod+Shift+L     { focus-monitor-right; }
    // Перенос колонки на соседний монитор
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J     { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K     { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    // --- Рабочие столы (workspaces) ---
    // Переключение на рабочий стол выше/ниже
    Mod+Page_Down      { focus-workspace-down; }
    Mod+Page_Up        { focus-workspace-up; }
    Mod+U              { focus-workspace-up; }
    Mod+I              { focus-workspace-down; }
    // Перенос колонки на рабочий стол выше/ниже
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }
    Mod+Shift+I         { move-column-to-workspace-down; }
    Mod+Shift+U         { move-column-to-workspace-up; }
    // Переместить сам рабочий стол выше/ниже
    Mod+Ctrl+Page_Down { move-workspace-down; }
    Mod+Ctrl+Page_Up   { move-workspace-up; }
    Mod+Ctrl+U         { move-workspace-up; }
    Mod+Ctrl+I         { move-workspace-down; }

    // --- Колесо мыши и горизонтальная прокрутка ---
    // Mod+колесо: переключение рабочих столов (cooldown-ms не даёт пролистать слишком быстро)
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // Горизонтальное колесо: фокус на колонку / перенос колонки
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    // Mod+Shift+колесо: вертикальное колесо двигает фокус по колонкам
    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // --- Прямой доступ к рабочим столам 1-9 ---
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    // Перенос колонки на рабочий стол с указанным номером
    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // --- Колонки: объединение и разделение ---
    // Втянуть окно в соседнюю колонку слева/справа или выдавить из колонки
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    // Втянуть в текущую колонку окно справа / выдавить окно из колонки
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // --- Размеры окон ---
    // Переключение пресетов ширины колонки / высоты окна
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    // Сбросить высоту окна
    Mod+Ctrl+R { reset-window-height; }
    // Развернуть колонку на всю ширину (с учётом отступов)
    Mod+F { maximize-column; }
    // Развернуть окно до краёв экрана
    Mod+Shift+F { maximize-window-to-edges; }
    // Растянуть колонку на всё свободное место
    Mod+Ctrl+F { expand-column-to-available-width; }
    // Центрировать колонку / все видимые колонки
    Mod+C { center-column; }
    Mod+Ctrl+C { center-visible-columns; }

    // Точная подстройка ширины колонки и высоты окна на 10%
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // --- Плавающие окна и табы ---
    // Сделать окно плавающим / вернуть в тайлинг
    Mod+V       { toggle-window-floating; }
    // Переключить фокус между плавающими и тайловыми окнами
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    // Колонка в режиме вкладок (табов)
    Mod+G { toggle-column-tabbed-display; }

    // --- Скриншоты ---
    // Выбор области / весь экран / текущее окно
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // --- Система ---
    // Отключить/включить перехват горячих клавиш окном (например, в VM или удалённом рабочем столе);
    // allow-inhibiting=false: сама комбинация перехватить нельзя, чтобы всегда можно было выйти из режима
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    // Выход из niri
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }
    // Выключить мониторы (включаются при движении мыши или нажатии клавиши)
    Mod+Shift+P { power-off-monitors; }
}

// ------------------------------------------------------------
//  Подключаемые файлы (DankMaterialShell)
//  Идут в конце, поэтому могут дополнять и переопределять настройки выше
// ------------------------------------------------------------
include "dms/windowrules.kdl"
include "dms/cursor.kdl"
include "dms/outputs.kdl"
include "dms/layout.kdl"
include "dms/binds.kdl"
